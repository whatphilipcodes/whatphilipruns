[Unit]
Description=Database for whatphilipdoes

[Container]
Image=docker.io/library/postgres:16-alpine
Environment=PGDATA=/var/lib/postgresql/data/pgdata
EnvironmentFile=/home/podman/.env
Volume=whatphilipstores.volume:/var/lib/postgresql/data
Network=internal.network
ContainerName=systemd-postgres

[Install]
WantedBy=default.target