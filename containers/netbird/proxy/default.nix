{ config, lib, pkgs, ... }:
let
  common = import ../common.nix { inherit config; };
  inherit (common) cfg containers ports proxyDomain;

  podman = "${config.virtualisation.quadlet.podman}/bin/podman";

  prepareProxy = pkgs.writeShellScript "netbird-proxy-prepare" ''
    set -euo pipefail
    export PATH=${lib.makeBinPath [ pkgs.coreutils pkgs.gnused pkgs.gnugrep ]}:$PATH

    podman=${lib.escapeShellArg podman}
    serverContainer="systemd-netbird-server"
    crowdsecContainer="systemd-netbird-crowdsec"

    ensure_proxy_token() {
      secretName="netbird-proxy-token"

      # Keep the management token stable across restarts and image updates.
      if "$podman" secret inspect "$secretName" >/dev/null 2>&1; then
        echo "Podman secret '$secretName' already exists; preserving it." >&2
        return 0
      fi

      echo "Creating a management-wide NetBird reverse-proxy token..." >&2
      last_error=""
      for attempt in $(seq 1 60); do
        if output=$("$podman" exec "$serverContainer" \
          /go/bin/netbird-server --config /etc/netbird/config.yaml \
          admin token create --name "netbird-proxy" 2>&1); then
          token=$(printf '%s\n' "$output" \
            | sed -n 's/^[[:space:]]*Token:[[:space:]]*//p' \
            | tail -n 1)

          # The one-time plaintext token is nbx_ plus 36 characters (40 total).
          if [ "''${token#nbx_}" = "$token" ] || [ ''${#token} -ne 40 ]; then
            echo "NetBird admin CLI did not return the expected 40-character nbx_ token." >&2
            echo "Refusing to store a token ID or malformed value." >&2
            exit 1
          fi

          printf '%s' "$token" | "$podman" secret create "$secretName" - >/dev/null
          unset token output
          echo "Created Podman secret '$secretName'." >&2
          return 0
        fi
        last_error="$output"
        sleep 2
      done
      echo "Could not create the NetBird proxy token after 60 attempts: $last_error" >&2
      return 1
    }

    ensure_crowdsec_bouncer_key() {
      secretName="netbird-crowdsec-bouncer-key"

      # The bouncer key is generated by CrowdSec, not randomly invented by Nix.
      # Keep the existing Podman secret so CrowdSec's registered bouncer and
      # the proxy continue to use the same credential after restarts.
      if "$podman" secret inspect "$secretName" >/dev/null 2>&1; then
        echo "Podman secret '$secretName' already exists; preserving it." >&2
        return 0
      fi

      echo "Waiting for the CrowdSec Local API..." >&2
      for attempt in $(seq 1 60); do
        if "$podman" exec "$crowdsecContainer" cscli lapi status >/dev/null 2>&1; then
          # If the Podman secret was lost but the CrowdSec database survived,
          # remove the orphaned registration before issuing a replacement key.
          "$podman" exec "$crowdsecContainer" \
            cscli bouncers delete netbird-proxy --ignore-missing >/dev/null 2>&1 || true

          if key=$("$podman" exec "$crowdsecContainer" \
            cscli bouncers add netbird-proxy -o raw 2>/dev/null); then
            key=$(printf '%s' "$key" | tr -d '\r\n')
            if [ -z "$key" ] || printf '%s' "$key" | grep -q '[[:space:]]'; then
              echo "CrowdSec returned an empty or malformed bouncer key; refusing to store it." >&2
              exit 1
            fi
            printf '%s' "$key" | "$podman" secret create "$secretName" - >/dev/null
            unset key
            echo "Created Podman secret '$secretName'." >&2
            return 0
          fi
        fi
        sleep 2
      done

      echo "CrowdSec LAPI did not become ready or bouncer registration failed." >&2
      echo "Inspect: journalctl --user -u netbird-crowdsec.service" >&2
      return 1
    }

    ensure_proxy_token
    ensure_crowdsec_bouncer_key
  '';

  proxyEnvironment = {
    # Containers use stable DNS aliases on the dedicated bridge network.
    NB_PROXY_DOMAIN = proxyDomain;
    NB_PROXY_MANAGEMENT_ADDRESS = "http://netbird-server:${toString ports.server}";
    NB_PROXY_ALLOW_INSECURE = "true";

    # Traefik reaches this listener over the dedicated bridge network. TLS is
    # passed through unchanged on the internal 8443 listener.
    NB_PROXY_ADDRESS = ":${toString ports.proxy}";
    NB_PROXY_CERTIFICATE_DIRECTORY = "/certs";
    NB_PROXY_ACME_CERTIFICATES = "true";
    NB_PROXY_ACME_CHALLENGE_TYPE = "tls-alpn-01";
    NB_PROXY_FORWARDED_PROTO = "https";

    # Traefik sends PROXY protocol v2. Trust only addresses on our dedicated
    # bridge subnet, rather than trusting all container networks.
    NB_PROXY_PROXY_PROTOCOL = "true";
    NB_PROXY_TRUSTED_PROXIES = cfg.network.subnet;

    NB_PROXY_WG_PORT = toString ports.proxyWireguard;
    NB_PROXY_LOG_LEVEL = "info";

    # CrowdSec LAPI is not published on the host; reach it using its network DNS alias.
    NB_PROXY_CROWDSEC_API_URL = "http://netbird-crowdsec:8080";
  } // lib.optionalAttrs (cfg.proxy.externalIPMap != null) {
    NB_PROXY_EXTERNAL_IP_MAP = cfg.proxy.externalIPMap;
  };
in
{
  virtualisation.quadlet.containers.netbird-proxy = {
    uid = containers.uid;
    containerConfig = {
      Image = cfg.images.proxy;
      AutoUpdate = "registry";
      Network = [ "netbird.network" ];
      NetworkAlias = [ "netbird-proxy" ];
      # The proxy's WireGuard listener and configured Layer-4 services must be
      # published directly; HTTPS/TLS traffic reaches it through Traefik.
      PublishPort = [ "${toString ports.proxyWireguard}:${toString ports.proxyWireguard}/udp" ]
        ++ cfg.proxy.additionalPublishPorts;
      Environment = proxyEnvironment;
      Volume = [
        "netbird-proxy-certs.volume:/certs"
      ];
      Secret = [
        "netbird-proxy-token,type=env,target=NB_PROXY_TOKEN"
        "netbird-crowdsec-bouncer-key,type=env,target=NB_PROXY_CROWDSEC_API_KEY"
      ];
    };

    # Generate management and CrowdSec bouncer credentials once, then preserve
    # them in the rootless Podman secret store across restarts and auto-updates.
    serviceConfig.ExecStartPre = "${prepareProxy}";
    unitConfig = {
      Requires = [ "netbird-server.service" "netbird-crowdsec.service" ];
      After = [ "netbird-server.service" "netbird-crowdsec.service" ];
    };
  };
}
